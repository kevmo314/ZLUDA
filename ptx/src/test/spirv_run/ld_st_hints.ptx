.version 8.0
.target sm_80
.address_size 64

.visible .entry ld_st_hints(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .u64 	    policy;
	.reg .u32 	    temp<4>;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];
	createpolicy.fractional.L2::evict_last.b64 policy, 1.0;

	ld.global.L2::128B.u32                      temp0, [in_addr];
	ld.global.nc.L1::no_allocate.L2::256B.u32   temp1, [in_addr+4];
	ld.global.L1::evict_last.L2::cache_hint.u32 temp2, [in_addr+8], policy;
	ld.relaxed.gpu.global.L2::64B.u32           temp3, [in_addr+12];
	st.global.L1::evict_first.u32               [out_addr], temp3;
	st.global.L2::cache_hint.u32                [out_addr+4], temp2, policy;
	st.global.u32                               [out_addr+8], temp1;
	st.global.u32                               [out_addr+12], temp0;
	ret;
}
