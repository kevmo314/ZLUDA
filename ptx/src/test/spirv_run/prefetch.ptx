.version 6.5
.target sm_30
.address_size 64

.visible .entry prefetch(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .u64 	    temp;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	prefetch.global.L2      [in_addr];
	prefetch.L1             [in_addr+8];
	ld.u64          temp, [in_addr];
	st.u64          [out_addr], temp;
	ret;
}
