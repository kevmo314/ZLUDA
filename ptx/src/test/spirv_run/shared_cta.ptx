.version 7.8
.target sm_80
.address_size 64

.visible .entry shared_cta(
    .param .u64 input,
    .param .u64 output
)
{
    .shared .align 8 .b8       shared_mem[16];

    .reg .u64                  in_addr;
    .reg .u64                  out_addr;
    .reg .u32                  shared_addr;

    .reg .u64                  temp1;
    .reg .u64                  temp2;
    .reg .u32                  temp3;

    ld.param.u64               in_addr,  [input];
    ld.param.u64               out_addr, [output];
    mov.u32                    shared_addr, shared_mem;

    ld.global.u64              temp1, [in_addr];
    st.shared::cta.u64         [shared_mem], temp1;
    cp.async.ca.shared::cta.global [shared_addr+8], [in_addr], 8;
    cp.async.wait_all;
    atom.shared::cta.add.u32   temp3, [shared_addr+8], 1;
    ld.shared::cta.u64         temp1, [shared_mem];
    ld.shared::cta.u64         temp2, [shared_addr+8];
    add.u64                    temp1, temp1, temp2;
    st.global.u64              [out_addr], temp1;
    ret;
}
